# ---------------------------------------------------------------------------
# Skyla Engineering Dashboard — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel Project Settings.
# ---------------------------------------------------------------------------

# BigQuery target (defaults shown — only override if your setup differs)
BQ_PROJECT_ID=skyla-analytics
BQ_DATASET_ID=Skyla_Engineering_Automation
BQ_LOCATION=US

# Per-table name overrides — ONLY if `npm run bq:verify` shows the live tables
# are named differently (e.g. the older eng_* convention). Bare table name;
# the dataset above is prepended automatically. Leave blank to use spec §3 names.
# BQ_TABLE_TICKETS=raw_eng_tickets
# BQ_TABLE_BILLS=raw_eng_bills
# BQ_TABLE_AMCS=raw_eng_amcs
# BQ_TABLE_LOOKER=raw_eng_looker_data
# BQ_TABLE_DROPLIST=dim_eng_droplist
# BQ_TABLE_PPM=raw_eng_ppm
# BQ_TABLE_TRAININGS=raw_eng_trainings
# BQ_TABLE_INCIDENTS=raw_eng_incidents
# BQ_TABLE_REVENUE=raw_eng_revenue

# Service account with roles/bigquery.dataViewer + roles/bigquery.jobUser.
# Paste the FULL service-account JSON on one line, OR base64-encode it.
# Both forms are accepted by lib/bigquery.ts.
#
#   Raw JSON  :  GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account", ... }
#   base64    :  GOOGLE_SERVICE_ACCOUNT_KEY=ewogICJ0eXBlIjogInNlcnZpY2Vf...
#
# To base64-encode locally:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   bash      : base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------------------------
# Dashboard login (HTTP Basic Auth) — see middleware.ts
# Set BOTH to require a username + password for the whole site.
# Leave either blank to disable the gate (e.g. first deploy / preview).
# Use a long random string for the password.
# ---------------------------------------------------------------------------
DASHBOARD_USER=skyla
DASHBOARD_PASSWORD=
